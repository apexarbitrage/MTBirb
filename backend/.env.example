DATABASE_URL=postgresql+psycopg://mtbirb:mtbirb@localhost:5432/mtbirb
EBIRD_API_KEY=
WEATHER_USER_AGENT=mtbirb (contact@example.com)
RAPIDAPI_KEY=
TOMTOM_API_KEY=
# Overpass endpoint for OSM trail discovery/geometry. Default is the main public instance; for a
# big one-time seeding sweep, point this at another public instance and switch back afterwards.
# Instances come and go - check https://wiki.openstreetmap.org/wiki/Overpass_API for the current
# list (e.g. maps.mail.ru/osm/tools/overpass, overpass.private.coffee) and verify before a run:
#   curl -m 20 -X POST --data-urlencode 'data=[out:json][timeout:5];node(1);out;' "$OVERPASS_URL"
# OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
# Set false on hosts whose egress IPs Overpass tarpits (Render/Fly/etc.) - hanging calls hold DB
# connections and 502 the app. OSM data then comes from seeding runs on a clean-IP machine.
# OVERPASS_ENABLED=false
# Shared secret for the admin-only ops endpoints (seed/sync/backfill/enrich). Send it as the
# X-Admin-Token header. Leave empty to disable those endpoints entirely (recommended unless you're
# actively seeding). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Observability (all optional). SENTRY_DSN turns on error tracking (leave blank to disable).
# LOG_FORMAT=json emits machine-readable logs for a deployed container; LOG_LEVEL tunes verbosity.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=plain
