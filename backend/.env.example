DATABASE_URL=postgresql+psycopg://mtbirb:mtbirb@localhost:5432/mtbirb
EBIRD_API_KEY=
WEATHER_USER_AGENT=mtbirb (contact@example.com)
RAPIDAPI_KEY=
TOMTOM_API_KEY=
# Shared secret for the admin-only ops endpoints (seed/sync/backfill/enrich). Send it as the
# X-Admin-Token header. Leave empty to disable those endpoints entirely (recommended unless you're
# actively seeding). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Observability (all optional). SENTRY_DSN turns on error tracking (leave blank to disable).
# LOG_FORMAT=json emits machine-readable logs for a deployed container; LOG_LEVEL tunes verbosity.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=plain
